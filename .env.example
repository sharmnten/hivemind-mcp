SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-or-local-anon-key
PUBLIC_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:5173
NODE_ENV=development
# Local development only: ordinary Supabase session tokens use this audience.
MCP_TOKEN_AUDIENCE=authenticated
# Production: set the audience to your exact public MCP resource URL and
# enable Supabase OAuth, registration and the access-token hook. See docs/oauth.md.
# The issuer defaults to SUPABASE_URL/auth/v1; override only for a compatible server.
# MCP_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1
# Optional worker-only credential. Never expose it to a browser or assistant.
# SUPABASE_WORKER_KEY=replace-with-server-only-supabase-secret-or-service-role-key
